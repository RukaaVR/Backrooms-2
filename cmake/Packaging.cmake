# Install layout mirrors the build tree: executable + shared libs + data/.
install(TARGETS BackroomsBeyondReality RUNTIME DESTINATION .)
install(DIRECTORY ${CMAKE_SOURCE_DIR}/engine/shaders/ DESTINATION data/shaders)
install(DIRECTORY ${CMAKE_SOURCE_DIR}/assets/ DESTINATION data/assets)
install(DIRECTORY ${CMAKE_SOURCE_DIR}/LICENSES/ DESTINATION LICENSES)
install(FILES ${CMAKE_SOURCE_DIR}/README.md DESTINATION .)
if(TARGET SDL3::SDL3-shared)
    install(IMPORTED_RUNTIME_ARTIFACTS SDL3::SDL3-shared DESTINATION . OPTIONAL)
endif()
if(UNIX AND NOT APPLE)
    set_target_properties(BackroomsBeyondReality PROPERTIES INSTALL_RPATH "$ORIGIN")
endif()

set(CPACK_PACKAGE_NAME "BackroomsBeyondReality")
set(CPACK_PACKAGE_VENDOR "Backrooms Beyond Reality Team")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
if(WIN32)
    set(CPACK_GENERATOR "ZIP")
else()
    set(CPACK_GENERATOR "TGZ")
endif()
include(CPack)
